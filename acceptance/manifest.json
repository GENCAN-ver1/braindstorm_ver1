      "title": "One-command legal completion",
      "requirement": "A single command runs a user request to a legal stop or COMMIT.",
      "implementation_module": "FV-01",
      "status": "IMPLEMENTED",
      "test_id": "tests.acceptance.test_ac01_one_command.OneCommandAcceptanceTests.test_ac_01_single_command_reaches_legal_stop",
      "fixtures": [
        "tests/acceptance/fixtures/ac01_one_command.json"
      ],
      "expected_states": [
        "EXPLORE",
        "RESEARCH_REQUIRED",
        "ITERATE",
        "COMMIT",
        "PARK",
        "NEEDS_INPUT"
      ],
      "expected_artifacts": [
        "machine-readable terminal summary",
        "Living Brief checkpoint"
      ]
    },
    {
      "id": "AC-02",
      "title": "Resume from any stage",
      "requirement": "Every interrupted stage resumes from the canonical Brief without duplicate side effects.",
      "implementation_module": "FV-02",
      "status": "IMPLEMENTED",
