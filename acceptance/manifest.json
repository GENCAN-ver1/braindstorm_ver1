      "expected_states": [
        "resumed equivalent state"
      ],
      "expected_artifacts": [
        "checkpoint envelope",
        "recovery trace"
      ]
    },
    {
      "id": "AC-03",
      "title": "Research and Worker isolation",
      "requirement": "Research or Worker failure cannot mutate or partially commit main state.",
      "implementation_module": "FV-04",
      "status": "IMPLEMENTED",
